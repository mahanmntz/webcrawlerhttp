{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ParsedDocument",
  "description": "Structured LLM-ready document extracted by the Python parser",
  "type": "object",
  "required": [
    "job_id",
    "url",
    "title",
    "meta_description",
    "extracted_links",
    "text_sample",
    "markdown",
    "estimated_tokens",
    "parsed_at"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    },
    "extracted_links": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "text_sample": {
      "type": "string"
    },
    "markdown": {
      "type": "string",
      "description": "Clean, token-efficient Markdown representation of the page body"
    },
    "estimated_tokens": {
      "type": "integer",
      "description": "Estimated token count for LLM context windows"
    },
    "raw_html_bytes": {
      "type": "integer"
    },
    "markdown_bytes": {
      "type": "integer"
    },
    "token_savings_pct": {
      "type": "number"
    },
    "parsed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
